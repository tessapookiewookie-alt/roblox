<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #e7e7e7;
  color: #252525;
  font-family: Arial, sans-serif;
}

.demo-banner {
  padding: 10px;
  background: #fff1cc;
  color: #694800;
  text-align: center;
  font-size: 13px;
  font-weight: bold;
}

main {
  width: 100%;
  max-width: 790px;
  margin: auto;
  padding: 42px 13px 50px;
  text-align: center;
}

h1 {
  margin: 0 0 56px;
  font-size: clamp(32px, 8vw, 64px);
  font-weight: 750;
}

.field {
  width: 100%;
  height: 78px;
  margin-bottom: 36px;
  padding: 0 26px;
  border: 2px solid #c9c9c9;
  border-radius: 18px;
  background: transparent;
  font-size: clamp(20px, 4.7vw, 39px);
}

.field:disabled {
  opacity: 1;
  -webkit-text-fill-color: #858585;
}

.login-button,
.device-button {
  width: 100%;
  min-height: 76px;
  border: 2px solid #777;
  border-radius: 18px;
  background: transparent;
  color: #555;
  font-size: clamp(21px, 4.6vw, 36px);
  cursor: not-allowed;
}

.forgot {
  margin: 52px 0 42px;
  font-size: clamp(19px, 4.3vw, 34px);
  font-weight: bold;
}

.divider {
  display: flex;
  align-items: center;
  gap: 24px;
  margin-bottom: 52px;
  font-size: 19px;
  font-weight: bold;
}

.divider::before,
.divider::after {
  content: "";
  height: 2px;
  flex: 1;
  background: #c9c9c9;
}

.device-button {
  margin-bottom: 72px;
}

.signup {
  font-size: clamp(19px, 4.2vw, 33px);
}

.notice {
  display: none;
  margin: 24px auto;
  padding: 14px;
  border: 1px solid #b34b42;
  border-radius: 10px;
  background: #fff0ee;
  color: #842b24;
  font-size: 16px;
}

@media (max-width: 480px) {
  main {
    padding-top: 38px;
  }
}
</style>
</head>

<body>

<div class="demo-banner">
  CYBERSECURITY TRAINING DEMO — NOT AN OFFICIAL ROBLOX LOGIN
</div>

<main>

<h1>Login to Roblox</h1>

<form autocomplete="off">

<input
  class="field"
  type="text"
  placeholder="Username/Email/Phone"
  disabled
>

<input
  class="field"
  type="password"
  placeholder="Password"
  disabled
>

<button
  class="login-button"
  type="button"
  id="demo-button"
>
  Log In
</button>

</form>

<div class="notice" id="notice">
  Training example: This page does not accept or collect
  credentials. Always check the website address before
  signing in.
</div>

<div class="forgot">
  Forgot Password or Username?
</div>

<div class="divider">
  <span>login with</span>
</div>

<button
  class="device-button"
  type="button"
  id="device-button"
>
  Another Logged In Device
</button>

<div class="signup">
  Don't have an account? <strong>Sign Up</strong>
</div>

</main>

<script>
const notice = document.getElementById("notice");

document.getElementById("demo-button")
.addEventListener("click", () => {
  notice.style.display = "block";
});

document.getElementById("device-button")
.addEventListener("click", () => {
  notice.style.display = "block";
});
</script>

</body>
</html>
